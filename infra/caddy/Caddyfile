# ------------------------------------------------------------------
# Tipote VPS — Caddy front (replaces nginx + certbot)
# ------------------------------------------------------------------
# What lives behind:
#   * Tipote        next-server  → 127.0.0.1:3000
#   * Tiquiz        next-server  → 127.0.0.1:3001
#   * popquiz-tus   node          → 127.0.0.1:1080   (tus uploads + /_validate-secure-link)
#   * n8n           docker        → 127.0.0.1:5678
#   * Self-hosted videos          → /srv/popquiz-videos (served by Caddy file_server)
#
# Custom domains for paid Tiquiz creators ride the catchall :443 block
# at the very bottom — on-demand Let's Encrypt issuance is gated by the
# Next API endpoint at /api/internal/caddy-ask.
#
# Cutover from nginx is documented in infra/caddy/README.md.

{
        # Let's Encrypt registration. Keep in sync with whatever email
        # is on the existing certbot account so renewals stay attached
        # to one identity.
        email hello@ethilife.fr

        # Per-host on-demand TLS for creator custom domains. Caddy
        # consults a tiny localhost dispatcher (infra/dispatcher in
        # the Tipote repo) which in turn fans out to BOTH apps'
        # /api/internal/caddy-ask endpoints — the cert is issued iff
        # either Tipote or Tiquiz has a `verified` row for the host.
        # This is what lets the same Caddy serve custom domains for
        # both apps without merging their databases.
        #
        # Two distinct secrets here:
        #   - $DISPATCHER_ASK_SECRET: Caddy ↔ dispatcher (this line)
        #   - each app's CADDY_ASK_SECRET: dispatcher ↔ that app
        # All three live in /etc/caddy/caddy.env (loaded via the
        # systemd unit EnvironmentFile=) and in /etc/default/dispatcher.env
        # — never in git.
        on_demand_tls {
                ask http://127.0.0.1:4000/caddy-ask?secret={$DISPATCHER_ASK_SECRET}
        }
}

# ------------------------------------------------------------------
# Reusable snippets
# ------------------------------------------------------------------

# Forward the original Host downstream so Next.js can detect the
# tenant (critical for the custom-domain middleware in Tiquiz). Without
# this, Caddy replaces Host with the upstream address (127.0.0.1:3001)
# and every request looks like it came from our own server.
#
# X-Forwarded-Proto is set by reverse_proxy by default, so we don't
# repeat it here (Caddy 2.11 warns when we do).
(proxy_headers) {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
}

# Block the usual probes (Wordpress, .env, .git) the same way nginx's
# security.conf did. Returns 444 (drop connection — no response body,
# no log noise) so bots stop hitting us.
(block_bad_paths) {
        @bad path_regexp bad ^/(\.env|\.git|wp-admin|wp-login|xmlrpc\.php|vendor|phpunit|cgi-bin|eval-stdin\.php)
        respond @bad 444
}

# CORS for the videos.* vhosts. Video player runs on quiz.tipote.com,
# files are on videos.*.tipote.com → cross-origin needs explicit allow.
(videos_cors) {
        header {
                Access-Control-Allow-Origin "*"
                Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
                Access-Control-Allow-Headers "Range, If-None-Match, If-Modified-Since"
                Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges"
                Cache-Control "private, max-age=300"
                X-Content-Type-Options "nosniff"
                # Drop the auto-added Server: Caddy header on these
                # public file responses — no point telling botnets.
                -Server
        }
}

# ------------------------------------------------------------------
# Tipote dashboard (app.tipote.com)
# ------------------------------------------------------------------
app.tipote.com {
        encode zstd gzip
        import block_bad_paths

        request_body {
                max_size 20MB
        }

        # Hashed static assets: aggressive immutable cache (mirrors the
        # explicit /_next/static/ location nginx had).
        @next_static path /_next/static/*
        header @next_static Cache-Control "public, max-age=31536000, immutable"

        # Everything else: no-cache HTML so Next route updates land
        # immediately on the next navigation.
        @not_next_static {
                not path /_next/static/*
        }
        header @not_next_static Cache-Control "private, no-cache, no-store, max-age=0, must-revalidate"

        reverse_proxy 127.0.0.1:3000 {
                import proxy_headers
        }
}

# ------------------------------------------------------------------
# Affiliate dashboard (affiliate.tipote.com)
# ------------------------------------------------------------------
# Sous-domaine dédié au dashboard des affiliés Tipote × Tiquiz. Sert le
# même Next.js que app.tipote.com (port 3000) — le middleware Next.js
# rewrite affiliate.tipote.com/* → /affiliate/* pour isoler ces routes
# du dashboard principal. Cf. middleware.ts dans tipote-app.
affiliate.tipote.com {
        encode zstd gzip
        import block_bad_paths

        request_body {
                max_size 5MB
        }

        @next_static path /_next/static/*
        header @next_static Cache-Control "public, max-age=31536000, immutable"

        @not_next_static {
                not path /_next/static/*
        }
        header @not_next_static Cache-Control "private, no-cache, no-store, max-age=0, must-revalidate"

        reverse_proxy 127.0.0.1:3000 {
                import proxy_headers
        }
}

# NOTE: tipote.com, www.tipote.com, tipote.fr and www.tipote.fr are
# NOT served from this VPS — they live on Systeme.io / CloudFront for
# the marketing pages. Their DNS doesn't even resolve to us, so trying
# to claim them here just made Let's Encrypt fail the HTTP-01 challenge
# for those names. Keep this Caddyfile scoped to the hosts we actually
# control (app.tipote.com plus the *.tipote.com infra subdomains).

# ------------------------------------------------------------------
# n8n (n8n.tipote.com)
# ------------------------------------------------------------------
n8n.tipote.com {
        import block_bad_paths

        reverse_proxy 127.0.0.1:5678 {
                import proxy_headers
                # n8n uses WebSockets for the editor; reverse_proxy
                # handles Upgrade automatically, but we disable buffering
                # so push notifications arrive in real time.
                flush_interval -1
        }
}

# ------------------------------------------------------------------
# Tiquiz (quiz.tipote.com)
# ------------------------------------------------------------------
quiz.tipote.com {
        encode zstd gzip
        import block_bad_paths

        reverse_proxy 127.0.0.1:3001 {
                import proxy_headers
                # The 5-min read_timeout the existing nginx vhost set
                # is preserved here — long quiz preview generation can
                # take that long.
                transport http {
                        read_timeout 5m
                }
        }
}

# ------------------------------------------------------------------
# Centre de pilotage (pilotage.tipote.com)
# ------------------------------------------------------------------
# Sert le MÊME Next.js que quiz.tipote.com (port 3001) : le centre de
# pilotage vit dans le dépôt Tiquiz, et next.config.ts rewrite
# pilotage.tipote.com/* -> /pilotage/*. Une 4e app aurait voulu dire un
# 4e .env, un 4e build et un 4e pm2 dans un déploiement manuel, c'est à
# dire exactement la configuration qui a croisé les clés Supabase des
# deux apps le 22 août. L'adresse dédiée sans le risque.
#
# CE BLOC DOIT EXISTER AVANT DE POSER LE DNS. Sans lui, l'hôte tombe
# dans le catchall :443, donc dans l'émission de certificat à la
# demande, qui interroge le dispatcher, qui ne trouve pas ce nom dans
# les domaines vérifiés des créatrices et refuse le certificat. Le
# navigateur afficherait alors une erreur TLS, sans rien dire de la
# cause.
#
# L'accès reste gardé DEUX fois côté app (middleware + layout) : cet
# écran montre les clients, l'argent et l'état des clés.
pilotage.tipote.com {
        encode zstd gzip
        import block_bad_paths

        # Aucun envoi de fichier ici : la console pilote, elle n'édite
        # pas. 5 Mo suffisent largement et bornent la surface.
        request_body {
                max_size 5MB
        }

        @next_static path /_next/static/*
        header @next_static Cache-Control "public, max-age=31536000, immutable"

        @not_next_static {
                not path /_next/static/*
        }
        header @not_next_static Cache-Control "private, no-cache, no-store, max-age=0, must-revalidate"

        # RIEN DE CE DOMAINE NE VA DANS UN MOTEUR DE RECHERCHE. Tout y
        # exige un compte admin, donc rien n'est crawlable de toute
        # façon, sauf la page de connexion. Un sous-domaine d'admin
        # indexé, c'est une adresse offerte à qui cherche une porte.
        header X-Robots-Tag "noindex, nofollow, noarchive"

        reverse_proxy 127.0.0.1:3001 {
                import proxy_headers
                # Les sondes de la section Paramètres interrogent
                # Stripe, PayPal et Resend, et la section Santé
                # interroge les deux autres apps. Chacune a son propre
                # délai maximum côté serveur, mais la réponse complète
                # peut cumuler : on laisse la même marge que le reste
                # de Tiquiz plutôt que de couper une page de
                # diagnostic au moment où on en a besoin.
                transport http {
                        read_timeout 5m
                }
        }
}

# ------------------------------------------------------------------
# LES DOMAINES DE VENTE (tiquiz.fr, atelierduquiz.fr)
# ------------------------------------------------------------------
#
# ILS ÉTAIENT CONFIGURÉS DIRECTEMENT SUR LE SERVEUR, ET PAS ICI.
#
# Le 29 août 2026, un `cp` de ce fichier vers /etc/caddy/Caddyfile a
# donc EFFACÉ leurs blocs : les deux pages de vente sont tombées en
# ERR_SSL_PROTOCOL_ERROR d'un coup. Sans bloc nommé, l'hôte tombe dans
# le catchall :443, donc dans l'émission de certificat à la demande, qui
# interroge le dispatcher, qui ne trouve pas ce nom dans les domaines
# vérifiés des créatrices et refuse le certificat. Caddy interrompt
# alors la poignée de main TLS, et le navigateur n'a rien à afficher
# d'autre qu'une erreur de protocole.
#
# **Règle : ce fichier est la SEULE vérité de la configuration Caddy.**
# Tout hôte servi en production a son bloc ICI. Une modification faite à
# la main sur le serveur est perdue au prochain déploiement, et elle ne
# se voit qu'au moment où la page de vente ne répond plus, c'est à dire
# au pire moment possible.
#
# Le `www` est servi par le même bloc : `SALES_HOSTS` (côté Tiquiz et
# côté Atelier) connaît les deux formes, et la balise canonique désigne
# l'adresse sans `www`. C'est elle qui consolide le référencement, pas
# une redirection de plus.

# Page de vente + bon de commande Tiquiz. Servis par l'app Tiquiz
# (port 3001), qui décide elle même d'ouvrir sans clé sur cet hôte
# (lib/sales/previewGate.ts). Le blog vit ici aussi : tiquiz.fr/blog.
tiquiz.fr, www.tiquiz.fr {
        encode zstd gzip
        import block_bad_paths

        # Les visuels du blog et les fichiers de la page de vente ne
        # changent qu'au déploiement : ils se mettent en cache long.
        # Tout le reste reste frais, parce qu'un bon de commande servi
        # depuis un cache afficherait un ancien prix.
        @statique path /_next/static/* /blog/img/* /sales/*
        header @statique Cache-Control "public, max-age=31536000, immutable"

        reverse_proxy 127.0.0.1:3001 {
                import proxy_headers
                transport http {
                        read_timeout 5m
                }
        }
}

# Page de vente + bon de commande de l'Atelier du Quiz, servis par
# l'app formaquiz (port 3002).
atelierduquiz.fr, www.atelierduquiz.fr {
        encode zstd gzip
        import block_bad_paths

        @statique path /_next/static/* /sales/*
        header @statique Cache-Control "public, max-age=31536000, immutable"

        reverse_proxy 127.0.0.1:3002 {
                import proxy_headers
                transport http {
                        read_timeout 5m
                }
        }
}

# ------------------------------------------------------------------
# L'Atelier du Quiz, l'APPLICATION (quizing.tipote.com)
# ------------------------------------------------------------------
# MÊME APP que `atelierduquiz.fr` juste au dessus (port 3002), et deux
# noms qui ne font PAS le même métier :
#
#   atelierduquiz.fr    -> la page de vente et le bon de commande
#   quizing.tipote.com  -> la formation elle même, derrière connexion
#
# CE BLOC A COÛTÉ UNE PANNE, ET C'EST LA DEUXIÈME FOIS (30 août 2026).
#
# Il n'a JAMAIS existé dans ce fichier : il était configuré à la main
# sur le serveur, comme l'étaient `tiquiz.fr` et `atelierduquiz.fr`
# avant le 29 août. Le `cp infra/caddy/Caddyfile /etc/caddy/Caddyfile`
# du déploiement l'a donc effacé, et l'Atelier a répondu **525** à tous
# ses élèves : sans bloc nommé, Caddy ne peut produire aucun certificat
# pour ce nom, donc il coupe la poignée de main.
#
# Le symptôme est cruel parce qu'il ne ressemble pas à sa cause : PM2
# est vert, l'app tourne, redémarrer ne change rien, et aucun journal
# d'application ne dit quoi que ce soit puisque AUCUNE requête n'arrive
# jusqu'à elle. Ce qui l'a tranché en une commande :
#
#   curl -sSv --resolve quizing.tipote.com:443:127.0.0.1 \
#        https://quizing.tipote.com/ -o /dev/null
#
# `TLS alert, internal error` = Caddy répond, mais il n'a pas de
# certificat pour ce nom.
#
# `scripts/check-caddy-hosts.mjs` ne pouvait pas l'attraper : il compare
# le dépôt au fichier VIVANT, et le fichier vivant l'avait déjà perdu.
# Il vérifie désormais AUSSI que tout hôte nommé par le code a son bloc
# ici (`ATELIER_BASE_URL`, lib/partner/atelierUrl.ts).
quizing.tipote.com {
        encode zstd gzip
        import block_bad_paths

        reverse_proxy 127.0.0.1:3002 {
                import proxy_headers
                # Même délai que les autres apps Next : une génération
                # de contenu par l'IA peut tenir plusieurs minutes, et
                # une coupure à 60 s ressemble à un bug de l'app.
                transport http {
                        read_timeout 5m
                }
        }
}

# ------------------------------------------------------------------
# tus uploads (tus.tipote.com + tus.quiz.tipote.com)
# ------------------------------------------------------------------
# Both names front the same popquiz-tus node server; the JWT's `app`
# claim picks the right secret server-side.
tus.tipote.com, tus.quiz.tipote.com {
        request_body {
                max_size 20GB
        }

        reverse_proxy 127.0.0.1:1080 {
                import proxy_headers
                # tus PATCH requests stream chunked bodies that can run
                # for an hour on flaky connections. Match the nginx
                # timeouts so we don't drop mid-upload.
                flush_interval -1
                transport http {
                        read_timeout 1h
                        write_timeout 1h
                        response_header_timeout 1h
                }
        }
}

# ------------------------------------------------------------------
# Self-hosted video playback (videos.*)
# ------------------------------------------------------------------
# Auth: every request must carry the signed `md5` + `expires` query
# params minted by lib/popquiz/playback.ts in Tiquiz / Tipote. Caddy
# defers the validation to popquiz-tus' /_validate-secure-link via
# forward_auth — see infra/tus-server/server.mjs.
#
# Range requests Just Work with file_server. CORS lives in a snippet
# above so preflight + actual response stay in sync.
videos.tipote.com, videos.quiz.tipote.com {
        root * /srv/popquiz-videos

        # CORS preflight short-circuit so OPTIONS never hits the
        # validator (no signed params on preflight).
        @options method OPTIONS
        handle @options {
                header {
                        Access-Control-Allow-Origin "*"
                        Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
                        Access-Control-Allow-Headers "Range, If-None-Match, If-Modified-Since"
                        Access-Control-Max-Age 86400
                }
                respond 204
        }

        # Block dotfiles + tus state JSONs explicitly, even though a
        # bad actor would also need a valid signature to fetch them.
        # Defense in depth costs nothing here.
        @blocked {
                path */.* /*.json
        }
        respond @blocked 403

        handle {
                forward_auth 127.0.0.1:1080 {
                        uri /_validate-secure-link
                }
                import videos_cors
                file_server {
                        precompressed gzip
                }
        }
}

# ------------------------------------------------------------------
# Catchall — creator custom domains (Tipote + Tiquiz, paid plans)
# ------------------------------------------------------------------
# Any host that didn't match a named block above lands here. The
# on_demand_tls in the global options decides whether to issue a cert
# (asks the dispatcher, which fans out to both apps). If the ask
# returns non-2xx the TLS handshake fails and the visitor sees a
# generic browser error — correct outcome for an unconfigured host.
#
# Dispatch (live requests):
#   1. forward_auth → dispatcher /lookup → returns a header
#      X-Dispatch-To: tipote | tiquiz indicating which backend owns
#      the hostname.
#   2. matcher reads that header and reverse_proxies to the right
#      port (3000 = Tipote, 3001 = Tiquiz).
#   3. If for any reason the header is missing (dispatcher down,
#      misconfigured), we default to Tiquiz — that's the historical
#      behaviour, so existing Tiquiz custom domains keep working
#      even if Tipote-side infra hiccups.
:443 {
        tls {
                on_demand
        }

        # Explicit route block so the directives below run in source
        # order — forward_auth must execute BEFORE the matchers that
        # read its copied header, and Caddy's default directive order
        # doesn't guarantee that for the alias forms.
        route {
                forward_auth 127.0.0.1:4000 {
                        uri /lookup
                        copy_headers X-Dispatch-To
                }

                @tipote header X-Dispatch-To tipote
                handle @tipote {
                        reverse_proxy 127.0.0.1:3000 {
                                import proxy_headers
                        }
                }

                # Default = Tiquiz (legacy + safety fallback when
                # dispatcher is unreachable or X-Dispatch-To wasn't
                # set for any reason — existing Tiquiz custom domains
                # keep working even if Tipote-side infra hiccups).
                reverse_proxy 127.0.0.1:3001 {
                        import proxy_headers
                }
        }
}
