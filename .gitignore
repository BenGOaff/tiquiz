# copywriting-claude/en-build/node_modules sous Windows (Function not implemented).
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Dossier de build du livre/copywriting (artefacts + deps), pas du code app
/copywriting-claude/en-build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Playwright (sorties de run, pas les references commitees)
/test-results/
/playwright-report/
