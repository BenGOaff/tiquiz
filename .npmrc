# openai (SDK) déclare un peer OPTIONNEL zod@^3, alors que le repo est en zod@4.
# Ce peer n'est utilisé que par un helper (zodResponseFormat) qu'on n'appelle pas,
# donc le conflit est inoffensif. legacy-peer-deps laisse npm ci/install résoudre
# sans erreur ERESOLVE (sinon le build prod échoue : fabric/openai/jspdf non installés).
legacy-peer-deps=true
