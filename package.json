{
  "name": "tiquiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-build-env.mjs",
    "check:supabase-keys": "node scripts/check-supabase-keys.mjs",
    "build": "next build",
    "postbuild": "node scripts/postbuild-standalone-static.cjs",
    "start": "next start",
    "lint": "eslint",
    "smoke": "bash scripts/smoke-public-routes.sh",
    "smoke:multiprofils": "node scripts/smoke-multiprofils.mjs",
    "diag:multiprofils": "node scripts/diagnose-multiprofils.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:migrations-pending": "node scripts/check-pending-migrations.mjs",
    "check:prod": "node scripts/check-prod.mjs",
    "check:storage": "node scripts/storage-audit.mjs",
    "storage:migrate": "node scripts/storage-migrate.mjs",
    "storage:archive": "node scripts/storage-archive.mjs",
    "paypal:setup": "node scripts/paypal-setup.mjs",
    "test:webhook": "node scripts/test-webhook-routing.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "audit:stats": "node scripts/audit-stats.mjs",
    "test:logic": "node --test --experimental-strip-types --import ./tests/logic/register-alias.mjs \"tests/logic/*.test.mts\"",
    "check:cta-affilie": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --experimental-strip-types --import ./tests/logic/register-alias.mjs scripts/check-cta-affilie.mts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "check:caddy": "node scripts/check-caddy-hosts.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:stripe": "node scripts/check-stripe.mjs",
    "blog:reparer": "node --experimental-strip-types --import ./tests/logic/register-alias.mjs scripts/reparer-blog.mjs",
    "blog:verifier": "node --experimental-strip-types scripts/reparer-blog.mjs --verifie",
    "blog:epingles": "node scripts/construire-epingles.mjs",
    "check:resend": "node scripts/check-resend.mjs",
    "check:ventes-sio": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --experimental-strip-types --import ./tests/logic/register-alias.mjs scripts/check-ventes-sio.mts",
    "vente:v2": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --experimental-strip-types --import ./tests/logic/register-alias.mjs scripts/construire-page-vente-v2.mjs",
    "vente:fonds": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --experimental-strip-types --import ./tests/logic/register-alias.mjs scripts/convertir-fonds-vente.mjs",
    "vente:images": "node scripts/reduire-images-vente.mjs",
    "check:deploye": "node scripts/check-deploye.mjs",
    "faq:extraire": "node --experimental-strip-types scripts/extraire-faq-vente.mjs",
    "anims:extraire": "node scripts/extraire-anims-vente.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@vidstack/react": "^1.12.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fabric": "^6.9.1",
    "hls.js": "^1.5.17",
    "isomorphic-dompurify": "^3.9.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "next": "16.2.3",
    "next-intl": "^4.9.0",
    "openai": "^4.104.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-colorful": "^5.6.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "recharts": "^2.12.7",
    "shadcn": "^4.2.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.2",
