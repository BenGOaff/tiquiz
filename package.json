    "openai": "^4.104.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-colorful": "^5.6.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
