{
  "name": "tiquiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild-standalone-static.cjs",
    "start": "next start",
    "lint": "eslint",
    "smoke": "bash scripts/smoke-public-routes.sh",
    "smoke:multiprofils": "node scripts/smoke-multiprofils.mjs",
    "diag:multiprofils": "node scripts/diagnose-multiprofils.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:migrations-pending": "node scripts/check-pending-migrations.mjs",
    "test:webhook": "node scripts/test-webhook-routing.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "audit:stats": "node scripts/audit-stats.mjs",
    "test:logic": "node --test --experimental-strip-types \"tests/logic/*.test.mts\"",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots"
  },
